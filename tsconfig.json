{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "skipLibCheck": false
  },
  "include": ["*.config.ts", "*.config.mjs", "**/*.mjs", "**/*.cjs"],
  "exclude": ["node_modules", "tests/consumer", "**/*.d.mts", "**/*.d.cts"]
}
