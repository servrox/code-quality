{
  "name": "@servrox/code-quality",
  "version": "0.2.0",
  "description": "Reusable Ultracite/Oxc presets and quality policy for servrox projects.",
  "homepage": "https://github.com/servrox/code-quality#readme",
  "bugs": {
    "url": "https://github.com/servrox/code-quality/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/servrox/code-quality.git"
  },
  "bin": {
    "code-quality-duplicates": "./jscpd/cli.mjs"
  },
  "files": [
    "oxlint",
    "oxfmt",
    "jscpd",
    "dependency-cruiser",
    "src"
  ],
  "type": "module",
  "exports": {
    "./oxlint/core": {
      "types": "./oxlint/core.d.mts",
      "default": "./oxlint/core.mjs"
    },
    "./oxlint/strict": {
      "types": "./oxlint/strict.d.mts",
      "default": "./oxlint/strict.mjs"
    },
    "./oxlint/modularity": {
      "types": "./oxlint/modularity.d.mts",
      "default": "./oxlint/modularity.mjs"
    },
    "./oxlint/anti-slop": {
      "types": "./oxlint/anti-slop.d.mts",
      "default": "./oxlint/anti-slop.mjs"
    },
    "./oxlint/react": {
      "types": "./oxlint/react.d.mts",
      "default": "./oxlint/react.mjs"
    },
    "./oxlint/playwright": {
      "types": "./oxlint/playwright.d.mts",
      "default": "./oxlint/playwright.mjs"
    },
    "./oxfmt": {
      "types": "./oxfmt/core.d.mts",
      "default": "./oxfmt/core.mjs"
    },
    "./jscpd": "./jscpd/core.json",
    "./dependency-cruiser": {
      "types": "./dependency-cruiser/core.d.cts",
      "default": "./dependency-cruiser/core.cjs"
    },
    "./dependency-cruiser/runtime": {
      "types": "./dependency-cruiser/core.d.cts",
      "default": "./dependency-cruiser/runtime.cjs"
    },
    "./dependency-cruiser/create-runtime-config": {
      "types": "./dependency-cruiser/create-runtime-config.d.cts",
      "default": "./dependency-cruiser/create-runtime-config.cjs"
    },
    "./baseline": {
      "types": "./src/baseline.d.mts",
      "default": "./src/baseline.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "lint": "ultracite check",
    "lint:policy": "oxlint --config oxlint.policy.config.mjs oxlint oxfmt src dependency-cruiser jscpd scripts",
    "fix": "ultracite fix",
    "check": "pnpm lint && pnpm lint:policy && tsc --noEmit && node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:package": "node scripts/check-package.mjs",
    "verify": "pnpm check && pnpm test && pnpm test:package"
  },
  "dependencies": {
    "eslint": "10.15.0",
    "eslint-plugin-sonarjs": "4.2.3",
    "eslint-plugin-unicorn": "79.0.0",
    "oxlint-plugin-eslint": "1.93.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "dependency-cruiser": "18.9.0",
    "jscpd": "5.4.3",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "6.0.3",
    "ultracite": "8.2.1"
  },
  "peerDependencies": {
    "dependency-cruiser": "18.9.0",
    "jscpd": "5.4.3",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "ultracite": "8.2.1"
  },
  "peerDependenciesMeta": {
    "dependency-cruiser": {
      "optional": true
    },
    "jscpd": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "pnpm@12.16.1"
}
